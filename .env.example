# توکن بات از @BotFather (این فایل را به .env تغییر نام بده و پر کن؛ هرگز در گیت‌هاب نگذار)
BOT_TOKEN=

# آیدی گروه خصوصی ادمین (با /id داخل گروه بگیر؛ معمولاً با -100 شروع می‌شود)
ADMIN_GROUP_ID=

# نام نمایشی در پیام‌ها
BOT_TITLE=مشاوره تخصصی نیما افشارنادری

# پرداخت کارت‌به‌کارت (مبلغ را هر بار با /pay تعیین می‌کنی)
CARD_NUMBER=
CARD_HOLDER=

# فقط اگر سرور داخل ایران است، مثلاً: socks5://127.0.0.1:1080
PROXY=

DB_PATH=consult.db

# فقط برای PythonAnywhere: یک رمز تصادفی بلند (فقط حروف و عدد انگلیسی)
WEBHOOK_SECRET=

# کانال‌هایی که عضویت در آن‌ها لازم است (بات باید در آن‌ها ادمین باشد)
REQUIRED_CHANNELS=@nimasdiner,@nimaafsharnaderi
